GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_GENERATION_MODEL=gemini-2.5-flash

# Comma-separated list of origins allowed to call this API (CORS). Falls
# back to the local Streamlit/static-frontend origins (localhost:8501) when
# unset -- only needed to add the deployed frontend origin(s) in production.
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://YOUR-VERCEL-DOMAIN.vercel.app

# Render Free has an ephemeral filesystem, so the validated Chroma runtime
# (the "adtu_knowledge" collection) is restored on startup from a published,
# checksummed GitHub Release snapshot when it is missing. Leave both blank
# for local development (the local data/processed/chroma_db is used as-is);
# set the URL on the Render service. The SHA-256 pins the exact validated
# 957-vector snapshot and is safe to commit -- it is a digest, not a secret.
ADTU_KB_SNAPSHOT_URL=
ADTU_KB_SNAPSHOT_SHA256=2d6ae1b6ecfb20e03ca69e40220f0c6a3bcd7a236d613203f0b96410a086f009
